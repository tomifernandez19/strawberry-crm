# Supabase (proyecto ZapaFlow — mismo proyecto que el ERP, schema "atencion")
NEXT_PUBLIC_SUPABASE_URL=https://rukdslcmxgmkiqxnplcs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_VzK_MdDjt71-tTJZlK87BA_xrjLJ9jC

# Nunca en el frontend. Solo la usan los route handlers (backend) para
# saltarse RLS. Se consigue en Supabase Dashboard > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API Keys. Necesaria recién para la Fase 10 (agente de IA).
ANTHROPIC_API_KEY=

# Fase 8. client_id/secret solo se usan una vez para la autorización inicial
# (no los usa el backend en cada request) — lo que realmente necesita el
# TiendaNubeService en runtime es STORE_ID + ACCESS_TOKEN.
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
# Nombre + contacto que la API exige en el header User-Agent de cada request.
TIENDANUBE_APP_CONTACT=contacto@strawberrytrejo.com

# Fase 12 — se completan canal por canal, a medida que estén dadas de alta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Instagram (Fase 12 — flujo "Instagram API con Instagram Login"):
# Instagram > API setup with Instagram business login, en el panel de la app.
# No hace falta guardar el ID de cuenta — "me" resuelve solo con el token.
INSTAGRAM_ACCESS_TOKEN=
# El "Instagram app secret" de esa misma sección — distinto del App Secret general.
INSTAGRAM_APP_SECRET=
# Un string inventado por vos, el mismo que cargues en Meta al configurar el webhook.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
MESSENGER_ACCESS_TOKEN=
MESSENGER_WEBHOOK_VERIFY_TOKEN=
